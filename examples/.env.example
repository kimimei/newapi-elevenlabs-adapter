# 示例脚本的配置模板
#
#   cp examples/.env.example examples/.env
#
# examples/.env 已被 .gitignore 排除，填了真实令牌也不会进仓库。
# 优先级：命令行参数 > 环境变量 > 本文件。

# ---- 适配器地址（必填）----
# 要带 /v1，脚本会自己拼 /audio/speech。忘了 /v1 是最常见的 404 原因，
# 脚本发现没带会自动补上并提示一次。
#   本机 Docker / 裸 Python： http://127.0.0.1:8123/v1
#   经 new-api 中转：        https://你的中转站域名/v1
ADAPTER_BASE_URL=http://127.0.0.1:8123/v1

# ---- 令牌 ----
# 两种场景别搞混：
#   直连自建适配器：填你的 ElevenLabs Key（sk_ 开头），适配器拿它去调上游；
#                  如果服务端 .env 里已配 ELEVENLABS_API_KEY，这里可以留空
#   经 new-api 中转：填面板发给你的令牌（通常是 sk- 开头），上游 Key 你根本看不到
ADAPTER_TOKEN=

# ---- 引擎与音色 ----
# 中文首选 eleven_v3（台湾口音也只有它支持）；模型是引擎，音色是 voice，两者独立
ADAPTER_MODEL=eleven_v3
ADAPTER_VOICE=yun

# ---- 可选：客户端超时（秒）----
# 这只是示例脚本自己的等待时间，和服务器上的 ELEVENLABS_TIMEOUT 不是一回事。
# 长文本请用 long_text_job.py 走异步，别靠调大这里。
REQUEST_TIMEOUT=180

# 复制为 .env 即可用；必填只有第一项
# bash scripts/up.sh --key sk_xxx 会自动帮你填

# ── 必填 ───────────────────────────────────────────────
# ElevenLabs 上游 Key（sk_ 开头）。
# 留空也能启动：此时必须由调用方在 Authorization 头里透传自己的 Key。
ELEVENLABS_API_KEY=
ELEVENLABS_API_BASE=https://api.elevenlabs.io/v1

# ── 端口 ───────────────────────────────────────────────
# ADAPTER_PORT 只决定「宿主机端口」，容器内固定监听 8123。
# 改这里 → 访问 http://<IP>:<该端口>
ADAPTER_PORT=8123
ADAPTER_HOST=0.0.0.0

# ── 上游调用 ───────────────────────────────────────────
# 单次上游请求超时（秒）。实测 ElevenLabs 合成速度约 33ms/字：
#   3000 字 ≈ 105s，2000 字 ≈ 98s，1000 字 ≈ 35s（含约 15s 固定开销）
#   默认 300 可覆盖约 8000 字。设太小 → 长文本必然超时且白扣费。
ELEVENLABS_TIMEOUT=300
# 失败重试次数。**默认 0，不要随便调大。**
#   ⚠️ 超时永不重试（代码层强制）：上游是「合成完才返回」，客户端超时只代表
#      自己不等了，上游那一侧已经合成并扣了费 —— 重试就是再扣一次。
#      实测某次 3000 字超时重试 3 次，白烧 4335 字符，一份音频都没拿到。
#   这个数只对 5xx / 429 / 连接中断生效（这些情况上游通常没合成完）。
ELEVENLABS_MAX_RETRIES=0

# 单次字符上限，0 = 不限制
ADAPTER_MAX_CHARS=0
# 请求体上限（字节），默认 2 MiB；超过直接 413。
# chunked 传输（无 Content-Length）同样会被拦 —— 计数是实际收上来的字节数。
ADAPTER_MAX_BODY_BYTES=2097152
# 同时处理的请求数上限，0 = 不限制。超了返回 429 并带 Retry-After。
# 上游按并发限流，不设闸门的话客户端只会看到"随机失败"。
ADAPTER_MAX_CONCURRENCY=0

# ── 安全（对外暴露时必读）─────────────────────────────
# 允许访问的来源 IP，逗号分隔；留空 = 不限制。
#
# ⚠️ 填的是**发起连接的地址**（TCP 对端），不是真实客户端 IP：
#    同机 nginx 终止 TLS 后转发 -> 填 127.0.0.1
#    跨机 nginx                -> 填那台 nginx 的内网 IP
#    docker 网络里的 new-api    -> 填容器网关，如 172.18.0.1
# 适配器**不读 X-Forwarded-For**（读了就能被伪造绕过白名单）。
# 拿不准就跑：python scripts/check_proxy_ip.py
# /healthz豁免此白名单 —— 配错时它是唯一的自查手段。
ADAPTER_ALLOW_IPS=
# =1 时允许回落到 ~/.elevenlabs/config.json 的本地明文 Key（共享主机请勿开启）
ADAPTER_ALLOW_LOCAL_KEY=0

# ── 模型列举范围 ───────────────────────────────────────
# none（默认）= /v1/models 只列 5 个标准引擎
# all         = 连补充包一起列（cn / tw / en / compat）
# cn,tw       = 指定包
# 注意：未启用的包只是「不列举」，别名仍可调用（不打断已注册渠道）
ADAPTER_PRESETS=none

# ── 长文本异步任务（可选，默认关闭）─────────────────────
# 配音客户第一单通常几千字，同步接口必然超时。用异步任务：
#   POST /v1/audio/speech/jobs        提交，返回 job_id
#   GET  /v1/audio/speech/jobs/{id}   轮询状态
#   GET  /v1/audio/speech/jobs/{id}/audio   下载音频
# 注意：任务表在进程内存里，重启会丢排队中的任务；多副本部署需要
#       sticky session（轮询必须打到提交时的那个副本）。
ADAPTER_JOBS_ENABLED=0
# 同时执行的任务数（对应上游并发）
ADAPTER_JOBS_WORKERS=2
# 排队上限，超出返回 429
ADAPTER_JOBS_MAX_PENDING=50
# 单任务字符上限
# 必须与 ELEVENLABS_TIMEOUT 匹配：实测 33ms/字。
#   经验公式：JOBS_MAX_CHARS ≈ (ELEVENLABS_TIMEOUT - 20) * 1000 / 33
#   TIMEOUT=300 → 约 8400 字；TIMEOUT=600 → 约 17000 字
# 填得比超时能覆盖的更多 = 该配置形同虚设，任务必然超时失败且白扣费。
ADAPTER_JOBS_MAX_CHARS=8000
# 完成后结果保留秒数（音频字节占内存，到期自动清）
ADAPTER_JOBS_TTL_SECONDS=1800

# ── 计费账本 ──────────────────────────────────────────
# 每个请求一行 JSONL，同时记录「向客户计费」与「上游真实消耗」，用于三层对账。
# 背景：new-api 的 logs 表只有一个 prompt_tokens 字段，装不下两个数；
#       靠时间戳猜配对，并发时必然配错，失败请求更是压根没有日志。
#
# 计费口径：
#   input   = 按客户提交的原始字符数（默认）。**与 new-api 同源** ——
#             new-api 的 prompt_tokens = utf8.RuneCountInString(input)，
#             收的就是这个数。账本记一样的数，客户拿后台日志逐笔都能对上。
#             清理掉的字符照样计费，但上游只收清理后的量，
#             所以省下的是我方成本，不是给客户的折扣。
#   chars   = 按实际合成字符数（清理后）。与 new-api 口径不一致，
#             会有 raw−sent 的恒定差额，仅在明确需要时启用。
#   upstream = 按上游真实积分。适合自用或大客户透明结算。
# 无论哪种口径，上游真实积分都会写进账本和 X-Usage-Upstream-Credits 头。
ADAPTER_BILLING_MODE=input
# 账本目录（按天切分为 YYYY-MM-DD.jsonl）。相对路径以运行目录为基准。
ADAPTER_BILLING_LOG_DIR=logs/billing
# 保留天数，启动/写入时清理更早的文件
ADAPTER_BILLING_LOG_DAYS=30
# =1 关闭账本。不建议 —— 关了就没法对账了
ADAPTER_BILLING_LOG_OFF=0

# ── 毛利换算（只影响 /v1/usage 的 gross_margin_ratio）────
# ⚠️ 这两个数不填 = **不算毛利率**（返回 null）。宁可没有，也不给一个错的。
#
# 历史实现是 1 - up_credits / bill_chars —— 拿**积分**除**字符**，
# 两个量纲不同的数相除，数学上无意义，但数字看着挺像回事，所以一直没被发现。
# 现在必须两边都换成美元再算。
#
# ADAPTER_UP_CREDITS_PER_USD：上游积分兑美元。
#   ElevenLabs Creator 档 $22 / 100,000 credits ≈ 4545.4545
#   按你实际套餐与折扣价填，不同档位差别很大。
ADAPTER_UP_CREDITS_PER_USD=0
# ADAPTER_CHARS_PER_USD：我方售价，每美元卖多少字符。
#   例：$0.08 / 千字符 → 12500
#   这个数必须与 new-api 侧配置的模型倍率一致，否则算的是"会计毛利率"。
ADAPTER_CHARS_PER_USD=0

# ── 文本清理 ──────────────────────────────────────────
# 送上游合成前清理不影响朗读的字符。默认只做「无损」处理：
#   off       只做换行规范化 + 首尾去空白
#   safe      默认。再去零宽字符/控制字符/连续空白折叠（人耳绝对听不出）
#   normalize 在 safe 基础上再去 Markdown 标记（**粗体**、[链接](url) 等）
#
# 刻意不删：U+200D/200C（参与 emoji 组合与文字连写，删了语义会变）、
#           Emoji 本身、重复标点（可能表达语气强度）。
#
# 计费不受清理档位影响：计费基数由 ADAPTER_BILLING_MODE 决定，
# 清理只改变**成本**（送上游的合成量），不改变计费。
# 客户提交的量、new-api 收的量、我们记账的量，三者必须完全相等。
ADAPTER_TEXT_CLEAN=safe

# ── 在线试听（可选，默认关闭）─────────────────────────
# =1 时 / 首页可免注册试听。开启等于公开消耗服务端 Key，务必配好下面三项。
ADAPTER_DEMO_ENABLED=0
ADAPTER_DEMO_MAX_CHARS=20
ADAPTER_DEMO_PER_HOUR=20
ADAPTER_DEMO_VOICES=zh-yingshi,zh-boyin,zh-pangbai

# ── 调试 ───────────────────────────────────────────────
# 1 = MOCK 模式：返回静音 WAV，不消耗额度。仅用于链路验证，上线务必 0。
# 响应头会带 X-Mock-Format: wav —— 标准库只能造 WAV，
# 请求 mp3 时也会拿到 WAV，别误判成格式转换问题。
ELEVENLABS_MOCK=0
